# .env.example — placeholder environment contract for the builder backend
#
# WHY THIS FILE EXISTS
#   It documents every environment variable the backend reads, so the real .env can
#   be created without guesswork and so a reviewer can see the full configuration
#   surface without access to any secret. It is the tracked counterpart to .env,
#   which is gitignored and never committed.
#
# LAYER
#   Runtime / configuration. These values are loaded once at startup into a single
#   pydantic-settings object in backend/config/. No other module reads os.environ
#   directly. (docs/runtime.md 3, 6)
#
# HOW TO USE
#   Copy to .env at the repository root, then replace the placeholders.
#   The backend runs from this directory (uvicorn backend.main:app), so .env is
#   read from here. (docs/runtime.md 7)
#
# RULES
#   - THIS FILE CONTAINS NO REAL SECRETS AND MUST NEVER CONTAIN ONE.
#   - .env is gitignored; .env.example is deliberately tracked. (.gitignore)
#   - Secrets are never logged, never returned by the API, and never passed into a
#     generated project's build. (docs/security.md 2, docs/runtime.md 3.4)
#
# Spec: docs/runtime.md 3.2 (this file mirrors that table exactly — no extra
#       variables, no omissions).

# =============================================================================
# Anthropic Claude — the only model provider in v1
# (CLAUDE.md 7, skills.md 10, docs/runtime.md 4)
# =============================================================================

# REQUIRED. The backend refuses to start without it. (docs/runtime.md 6)
# SECRET — loaded as a Pydantic SecretStr so repr/str redact it.
# Replace the placeholder below with your real key in .env, never here.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Default model for every agent role.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional model for heavy-reasoning roles. A role opts in through configuration,
# never hard-coded in an agent module. (docs/runtime.md 4.1)
ANTHROPIC_MODEL_HEAVY=claude-opus-5

# =============================================================================
# Application
# =============================================================================

# development | production
APP_ENV=development

LOG_LEVEL=INFO

# =============================================================================
# API server
# (docs/api.md 1.1, docs/security.md 9)
# =============================================================================

# MUST stay loopback while there is no authentication. A project_id alone grants
# read and mutate access, so this server must not be exposed publicly yet.
API_HOST=127.0.0.1

API_PORT=8000

# CORS allowlist. Matches the Vite dev origin. (docs/frontend.md 2)
ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# Builder runtime data
# (docs/state.md 5.1, docs/architecture.md 5.1)
# =============================================================================

# Root for checkpoints, project state artifacts, uploaded reference images and
# generated website workspaces. Gitignored as var/ — machine-local output.
BUILDER_DATA_DIR=./var

# =============================================================================
# Reference image uploads
# (docs/api.md 2.4, docs/security.md 4)
# =============================================================================

# 10 MB. Exceeding this returns 413 upload_too_large.
MAX_UPLOAD_BYTES=10485760

# Allowlist. Content type is confirmed by magic bytes, not the declared header;
# a mismatch returns 415. Uploads are never executed.
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp

# =============================================================================
# Workflow
# (docs/workflow.md 4, docs/state.md 5.3)
# =============================================================================

# Session idle lifetime, 24h. A session carries no approved decisions; losing one
# never loses project state.
SESSION_TTL_MINUTES=1440

# Maximum automatic correction iterations. At this limit the workflow stops and
# returns control to the user rather than regenerating again. Must be >= 1.
MAX_AUTO_ITERATIONS=3

# =============================================================================
# Generated-project build
# (docs/architecture.md 5.3)
# =============================================================================

# Build steps are killed on overrun.
PREVIEW_BUILD_TIMEOUT_SECONDS=180

# =============================================================================
# Optional features
# =============================================================================

# Cost optimization only. Off until measured; it must never change agent
# behavior. (docs/runtime.md 5)
ENABLE_PROMPT_CACHING=false

# GitHub MCP connection. No MCP server is connected in v1, and the core workflow
# must run with zero MCP servers. (docs/mcp.md 1)
MCP_GITHUB_ENABLED=false


# =============================================================================
# DELIBERATELY ABSENT — do not add without an explicit decision
# =============================================================================
#
#   Supabase / PostgreSQL connection variables
#       The database is decided (Supabase/PostgreSQL) but its schema is undecided
#       by design. Connection variables are added when the user defines the
#       schema. When they arrive, the connection string and service key are
#       SECRETS under the same rules as ANTHROPIC_API_KEY.
#       (CLAUDE.md 9A, docs/architecture.md 3.8, docs/runtime.md 3.2)
#
#   Impeccable enable/disable flag
#       Intentionally does not exist. Impeccable is a MANDATORY gate, not a
#       feature toggle. The runtime probes availability; if it is unavailable the
#       Evaluation stage reports blocked and stops. A flag that could silently
#       turn the gate off must never be added.
#       (CLAUDE.md 15, docs/design.md 5, docs/runtime.md 3.2)
#
#   Checkpointer configuration
#       The checkpointer is undecided pending the persistence architecture, so it
#       has no configuration yet. (docs/state.md 5.1)
#
#   Zapier credentials
#       Deferred. Optional automation layer only. (CLAUDE.md 19A, docs/mcp.md 2.4)
#
#   Second provider credentials
#       Not permitted in v1. (CLAUDE.md 7)
